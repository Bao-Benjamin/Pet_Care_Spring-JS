<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="training.javaweb.exam.JavaWebExam_lhgbao.mapper.AccountMapper">
	<insert id="createAccount">
		insert into account(password,owner_id, role) values(
			#{password},
			#{ownerId},
			#{roles}
		)
	</insert>
</mapper>